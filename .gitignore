__pycache__/
*.py[cod]
*$py.class

# Cpython / PyPy caches
*.so
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# CatBoost & XGBoost training artifacts/logs
catboost_info/

# Model artifacts (optional: uncomment if you do not want to push trained model binaries)
